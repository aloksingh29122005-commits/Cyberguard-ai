# Copy this file to a new file named ".env" and fill in your own values.
# The real ".env" file must NEVER be shared or uploaded to GitHub.

# A long random text used to sign your login sessions.
# Create one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me

# 1 = show detailed errors while you develop on your own computer.
# Never use 1 on a real server.
FLASK_DEBUG=1

# Keep false while testing on http://127.0.0.1. Use true only when the site runs on HTTPS.
SESSION_COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# AI (optional). CyberGuard AI works fully without it.
# To use it, remove the "#" in front of the lines of ONE option below and
# paste your own key. Never share or upload your key.
# Model names change often: copy a current one from the provider's website.
# ---------------------------------------------------------------------------
AI_PROVIDER=none

# Option A: Anthropic (Claude). Paid service.
# AI_PROVIDER=anthropic
# AI_API_KEY=your key from the Anthropic Console
# AI_MODEL=a model name from Anthropic's documentation

# Option B: Google Gemini (has a free tier, read Google's current terms).
# AI_PROVIDER=openai_compatible
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# AI_API_KEY=your key from Google AI Studio
# AI_MODEL=a Gemini model name from Google's documentation

# Option C: Ollama on your own computer (free, no key needed).
# AI_PROVIDER=openai_compatible
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=the name of a model you downloaded (see "ollama list")

# Limits (these are the defaults)
# AI_TIMEOUT_SECONDS=30
# AI_MAX_OUTPUT_TOKENS=600
# AI_MAX_CALLS_PER_HOUR=30